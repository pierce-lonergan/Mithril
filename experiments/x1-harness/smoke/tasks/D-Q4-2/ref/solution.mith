// D-Q4-2 reference (Mithril). The first loop writes every element unconditionally, which is what
// mithi's NaN-cover rule needs before the guarded writes (E-NAN-RAW-SINK otherwise); the guard
// `k < y.len()` discharges the index obligation (T2 does not relate g * 64 + i to y.len()).
kernel fn q4_dequant(w: &[BlockQ4], y: &mut [f32])
    requires y.len() == w.len() * 64
{
    for k in 0..y.len() {
        y[k] = 0.0;
    }
    for g in 0..w.len() {
        let blk = w[g];
        let d = blk.d.to_f32();
        for i in 0..64 {
            let k = g * 64 + i;
            if k < y.len() {
                y[k] = canon::nan((blk.q.elem(i) as f32) * d);
            }
        }
    }
}
