// MUTANT nan_first: NaN ranks before every number. CANARY: expected FAIL.
kernel fn topk(sel: &[f32], k: usize, ids: &mut [u32])
    requires ids.len() == k && k <= sel.len() && sel.len() <= 256
{
    let mut taken = [false; 256];
    for r in 0..ids.len() {
        let mut best: usize = 0;
        let mut best_v: f32 = 0.0;
        let mut have = false;
        for i in 0..sel.len() {
            if taken[i] { continue; }
            if !have || ranks_before(sel[i], best_v) {
                best = i;
                best_v = sel[i];
                have = true;
            }
        }
        if have && best < 256 {
            taken[best] = true;
        }
        ids[r] = best as u32;
    }
}

kernel fn ranks_before(a: f32, b: f32) -> bool {
    if b.is_nan() { return false; }
    if a.is_nan() { return true; }
    a > b
}
