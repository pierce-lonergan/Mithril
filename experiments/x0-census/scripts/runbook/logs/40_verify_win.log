==== clang-cl -### : cc1 FP/ISA flags per driver option set
[clang-cl ]
-fmath-errno -ffp-contract=on -fno-rounding-math -target-cpu=x86-64 -tune-cpu=generic -stack-protector=2
[clang-cl /fp:precise]
-fmath-errno -ffp-contract=on -fno-rounding-math -complex-range=full -target-cpu=x86-64 -tune-cpu=generic -stack-protector=2
[clang-cl /fp:strict]
-fmath-errno -ffp-contract=off -frounding-math -ffp-exception-behavior=strict -complex-range=full -target-cpu=x86-64 -tune-cpu=generic -stack-protector=2
[clang-cl /fp:fast]
