[clang-cl /O2 /fp:precise]
-O3 -fmath-errno -ffp-contract=on -fno-rounding-math -complex-range=full -target-cpu=x86-64 -tune-cpu=generic -stack-protector=2 -ffunction-sections -vectorize-loops -vectorize-slp
